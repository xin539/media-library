# Copy to .env and fill in your own database credentials. Never commit .env.
PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=media_library
MYSQL_USER=media_library
MYSQL_PASSWORD=
COOKIE_SECURE=false
# Optional legacy WeChat settings. Not required for username/password login.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
